+def _qq_delivered_fragments(message: SessionMessage, batch: DeliveryBatch) -> Optional[List[SessionMessage]]:
+    for receipt in batch.receipts:
+        parts = receipt.metadata.get("qq_official_parts")
+        if not (receipt.driver_id or "").endswith(":qq_official_gateway") or not isinstance(parts, list):
+            continue
+        delivered: List[SessionMessage] = []
+        original = message.raw_message.components
+        for part in parts:
+            if part.get("status") != "sent" or not part.get("id"):
+                continue
+            selected = [deepcopy(original[index]) for index in part["segment_indices"]]
+            fragment = deepcopy(message)
+            fragment.raw_message = MessageSequence(components=selected)
+            fragment.processed_plain_text = _build_processed_plain_text(fragment).strip()
+            if part["kind"] == "body" and all(isinstance(component, TextComponent) for component in selected):
+                fragment.processed_plain_text = part["visible_text"]
+                fragment.raw_message = MessageSequence(components=[TextComponent(text=part["visible_text"])])
+            if part["quoted"]:
+                fragment.raw_message.components[:0] = [
+                    deepcopy(component) for component in original if isinstance(component, ReplyComponent)
+                ]
+            fragment.message_id = fragment.platform_message_id = part["id"]
+            flags = _detect_outbound_message_flags(fragment.raw_message)
+            fragment.is_emoji, fragment.is_picture = flags["is_emoji"], flags["is_picture"]
+            delivered.append(fragment)
+        return delivered
+    return None
+
