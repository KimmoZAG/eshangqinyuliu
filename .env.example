# 复制为 .env 后填写。node 通过 --env-file=.env 加载。
QQ_APP_ID=
QQ_APP_SECRET=

# 订阅事件位，默认 GROUP_AND_C2C_EVENT = 1<<25 = 33554432
QQ_INTENTS=33554432

# OpenAI 兼容模型
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 专用数据工具和通用网页搜索分别开启
DATA_TOOLS_ENABLED=1
SEARCH_ENABLED=0

# 群聊和私聊可在消息开头用 /快答、/自动、/深想 覆盖本轮
REPLY_MODE=auto
REPLY_FAST_MS=7000
REPLY_AUTO_MS=15000
REPLY_DEEP_MS=25000
REPLY_MAX_QUESTIONS=5
TOOL_CONCURRENCY=3

# effort 发送 reasoning_effort，thinking 发送 thinking.type，none 不发送思考参数
LLM_REASONING_STYLE=effort
LLM_AUTO_EFFORT=none
LLM_DEEP_EFFORT=low
