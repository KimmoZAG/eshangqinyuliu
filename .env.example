# 复制为 .env 后填写。node 通过 --env-file=.env 加载。
QQ_APP_ID=
QQ_APP_SECRET=

# 订阅事件位，默认 GROUP_AND_C2C_EVENT = 1<<25 = 33554432
QQ_INTENTS=33554432

# OpenAI 兼容模型
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# MaiBot 试点范围，用 QQ 开放平台消息事件中的 OpenID，以逗号分隔。
JINHUA_QQ_GROUPS=
JINHUA_QQ_USERS=
JINHUA_ADMIN_OPENIDS=

# 可选：分别指定模型任务。留空时复用 LLM_MODEL，记忆使用稀疏检索。
# JINHUA_PLANNER_MODEL=
# JINHUA_REPLY_MODEL=
# JINHUA_FAST_MODEL=
# JINHUA_DEEP_MODEL=
# JINHUA_EMBEDDING_MODEL=
# JINHUA_MCP_CONFIG=config/mcp.local.json

# 专用数据工具和通用网页搜索分别开启
DATA_TOOLS_ENABLED=1
SEARCH_ENABLED=0

# 群聊和私聊可在消息开头用 /快答、/自动、/深想 覆盖本轮
REPLY_MODE=auto
REPLY_FAST_MS=7000
REPLY_AUTO_MS=15000
REPLY_DEEP_MS=25000
REPLY_MAX_QUESTIONS=5
TOOL_CONCURRENCY=3

# effort 发送 reasoning_effort，thinking 发送 thinking.type，none 不发送思考参数
LLM_REASONING_STYLE=effort
LLM_AUTO_EFFORT=none
LLM_DEEP_EFFORT=low

# ---- 运行时调参（都有默认值，可留空）----
# 模型任务硬超时（秒），太小会把已经生成好的回复丢掉
# JINHUA_TASK_TIMEOUT=30
# Unicode emoji 出站过滤：safe / strip / all
# EMOJI_MODE=safe
# 带图概率闸门（0~1）
# JINHUA_EMOJI_P=0.45
# 送进 planner 的历史消息条数上限
# JINHUA_HISTORY_LIMIT=50
# 工具调用预算（毫秒），超出不再给查询工具
# JINHUA_TOOL_BUDGET_MS=8000
# 多条 @ 的合并窗口（毫秒）
# JINHUA_MERGE_WINDOW_MS=2000
# 兜底延迟（毫秒）
# JINHUA_FALLBACK_MS=20000
# 强制放行的危险 emoji 字符
# EMOJI_EXTRA=

# ---- 联网搜索 ----
# deepseek：走 DeepSeek 服务端检索（带引用，慢 3~10s）；anysearch：旧的轻量搜索
# SEARCH_PROVIDER=deepseek
# DeepSeek 检索超时（毫秒），超时后自动回退 anysearch
# SEARCH_DS_TIMEOUT_MS=15000
# 工具调用总预算（毫秒），必须大于检索耗时，否则查到的结果会被丢弃
# JINHUA_TOOL_BUDGET_MS=20000
